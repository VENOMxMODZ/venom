TARGET := iphone:clang:latest:14.0
ARCHS = arm64 arm64e

include $(THEOS)/makefiles/common.mk

TWEAK_NAME = DefineAura

DefineAura_FILES = src/SecurityHardening.m \
                   src/APIClient.m \
                   src/SessionManager.m \
                   src/ModuleInterface.m \
                   src/LoginManager.m \
                   src/LoginViewController.m \
                   src/FloatingView.m \
                   src/FloatingController.m \
                   src/DylibEntry.m

DefineAura_CFLAGS = -fobjc-arc -O3 -fvisibility=hidden -I./include -Wno-unused-parameter
DefineAura_LDFLAGS = -Wl,-dead_strip
DefineAura_FRAMEWORKS = UIKit Foundation Security CoreGraphics QuartzCore

include $(THEOS_MAKE_PATH)/tweak.mk
